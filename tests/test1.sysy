const int gc1 = 5, gc2 = 10;
int g1 = 3, g2 = 7;

int main() {
    /* 第一阶段：简单if语句（1变量）*/
    int a = gc1 + g1;      // 5 + 3 = 8
    if (a > 5) {
        a = a + 2;         // a = 8 + 2 = 10
    }

    /* 第二阶段：while循环（1变量）*/
    int b = 0;
    while (b < gc2) {
        b = b + 1;         // b = b + 1
    }

    /* 第三阶段：嵌套while循环（2变量）*/
    int c = 0;
    int d = 0;
    while (c < 5) {
        d = 0;
        while (d < 3) {
            d = d + 1;     // d = d + 1
        }
        c = c + 1;         // c = c + 1
    }

    /* 第四阶段：if-else语句（1变量）*/
    int e = 0;
    if (b > a) {
        e = b - a;         // e = 10 - 10 = 0
    } else {
        e = a - b;         // e = 10 - 10 = 0
    }

    /* 第五阶段：嵌套while循环（修改g1，检查g2）*/
    int f = 0;
    while (g1 < g2) {
        f = f + 1;         // f = f + 1
        g1 = g1 + 1;       // g1 = g1 + 1
        while (g1 < g2) {
            f = f + 1;     // f = f + 1
            g1 = g1 + 1;   // g1 = g1 + 1
        }
    }

    // 最终结果验证
    return a + b + c + d + e + f;   // 返回 10 + 10 + 5 + 3 + 0 + 4 = 32
}
