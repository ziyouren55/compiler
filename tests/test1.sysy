const int gc1 = 3, gc2 = 6, gc3 = 9;
int g1 = 4, g2 = 7, g3 = 11;

int main() {
    // 第一阶段：基础算术表达式
    int a = gc1 * 3 + g1;          // 9 + 4 = 13
    int b = (g2 % 6) * gc2;        // 7 % 6 = 1 → 1 * 6 = 6
    int c = a * b;                 // 13 * 6 = 78

    // 第二阶段：组合算术表达式
    int d = c / 4 + g1;            // 78 / 4 = 19 + 4 = 23
    int e = (d + g2) * gc2;        // (23 + 7) * 6 = 30 * 6 = 180
    int f = e % 100;               // 180 % 100 = 80
    int g = f * 2 + g1;            // 80 * 2 + 4 = 160 + 4 = 164

    // 第三阶段：更复杂的表达式
    int h = g - (g2 * 2);          // 164 - (7 * 2) = 164 - 14 = 150
    int i = (h + gc3) * 2;         // (150 + 9) * 2 = 159 * 2 = 318
    int j = i / 3 + g1;            // 318 / 3 = 106 + 4 = 110
    int k = j * 4 - g3;            // 110 * 4 - 11 = 440 - 11 = 429

    // 第四阶段：多阶段组合表达式
    int l = (k + g2) * (gc3 - g1); // (429 + 7) * (9 - 4) = 436 * 5 = 2180
    int m = l / 10 + g2;           // 2180 / 10 = 218 + 7 = 225
    int n = (m * 3) - 15;          // 225 * 3 - 15 = 675 - 15 = 660

    // 第五阶段：最终组合表达式
    int o = (n + g3) * 2;          // (660 + 11) * 2 = 671 * 2 = 1342
    int p = o % 500;               // 1342 % 500 = 342
    int q = p * 2 + g1;            // 342 * 2 + 4 = 684 + 4 = 688

    // 最终结果验证
    return q;                      // 返回 688
}
